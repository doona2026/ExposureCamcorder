{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "icon": "icon.png",
  "contact": {
    "homepage": "${mod_page}",
    "issues": "${mod_issues}"
  },
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "io.github.exposure_camcorder.fabric.ExposureCamcorderFabric"
    ],
    "client": [
      "io.github.exposure_camcorder.fabric.ExposureCamcorderFabricClient"
    ]
  },
  "mixins": [
    "exposure_camcorder-common.mixins.json",
    "exposure_camcorder-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21",
    "java": ">=21",
    "fabric-api": "*",
    "forgeconfigapiport": ">=21.0.0",
    "exposure": "*"
  }
}
